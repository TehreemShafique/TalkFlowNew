# Backend Local Development Environment Overrides
# Copy to `.env` and fill in real values. `.env` is gitignored - never commit it.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/talkflow
REDIS_URL=redis://localhost:6379/1

# Sign access JWTs and validate them (must match each other and be unique per env).
JWT_ACCESS_SECRET=generate-a-random-32-byte-hex-string
SECRET_KEY=generate-a-different-random-32-byte-hex-string

# --- VICIdial Non-Agent API (B3-1) ------------------------------------------
# Uncomment after filling in your VICIdial server values (user level >= 8).
# VICIDIAL_URL=http://localhost/vicidial/non_agent_api.php
# VICIDIAL_USER=talkflow_api
# VICIDIAL_PASS=your_api_password
# VICIDIAL_SOURCE=talkflow
# VICIDIAL_DEFAULT_CAMPAIGN_ID=TEST_CAMP
# VICIDIAL_DEFAULT_LIST_ID=1001

# --- VICIdial Telephony Edge (BACKEND-8a) ------------------------------------
# Shared secret VICIdial echoes in X-TalkFlow-Telephony-Token on webhooks.
# Must be identical on both sides or every webhook 401s.
TELEPHONY_WEBHOOK_TOKEN=change-me
# Asterisk AMI restricted read-only manager credentials (port 5038).
# ASTERISK_AMI_HOST=localhost
# ASTERISK_AMI_PORT=5038
# ASTERISK_AMI_USER=talkflow_ami
# ASTERISK_AMI_PASS=your_ami_password
